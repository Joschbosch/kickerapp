<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zur.koeln</groupId>
        <artifactId>kickertool</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>kickertool-bootstrap</artifactId>
    <name>kickertool-bootstrap</name>
    <description>Startbare Spring-Boot-Anwendung: verdrahtet Domäne, Anwendung und Adapter</description>

    <dependencies>
        <dependency>
            <groupId>zur.koeln</groupId>
            <artifactId>kickertool-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>zur.koeln</groupId>
            <artifactId>kickertool-application</artifactId>
        </dependency>
        <dependency>
            <groupId>zur.koeln</groupId>
            <artifactId>kickertool-adapter-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>zur.koeln</groupId>
            <artifactId>kickertool-adapter-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>zur.koeln</groupId>
            <artifactId>kickertool-adapter-events</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- nur für Tests und mit dem Maven-Profil "local", nie im Produktions-Jar -->
        <dependency>
            <groupId>zur.koeln</groupId>
            <artifactId>kickertool-local</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Lokaler Testmodus ohne Docker: H2 im Speicher und simulierter OIDC-Provider.
            Start: ./mvnw -pl kickertool-bootstrap -Plocal spring-boot:run
        -->
        <profile>
            <id>local</id>
            <properties>
                <spring-boot.run.profiles>local</spring-boot.run.profiles>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>zur.koeln</groupId>
                    <artifactId>kickertool-local</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
