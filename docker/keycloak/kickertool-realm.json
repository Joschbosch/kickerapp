      {
        "name": "kicker-admin",
        "description": "Turnierleitung: darf Turniere verwalten, Runden starten und Ergebnisse festlegen"
      }
    ]
  },
  "clients": [
    {
      "clientId": "kickertool-app",
      "name": "Kickertool App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
